<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>ItsFrosti.OptimizationsMod</AssemblyName>
    <RootNamespace>ItsFrosti.OptimizationsMod</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>dist/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GameRoot Condition="'$(GameRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common</GameRoot>
    <GameManaged>$(GameRoot)/Subnautica2018/Subnautica_Data/Managed</GameManaged>
    <LoaderDirectory Condition="'$(LoaderDirectory)' == ''">$(MSBuildThisFileDirectory)../SNSRModLoader/artifacts/package/Mods/Loader</LoaderDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Plugin/**/*.cs" />
    <Compile Include="Optimizations/**/*.cs" />
    <Reference Include="SNSRModLoader"><HintPath>$(LoaderDirectory)/SNSRModLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(LoaderDirectory)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManaged)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
